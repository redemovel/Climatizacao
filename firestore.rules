rules_version = '2';
// Atualizado: 2026-11-07 — faturação: cliente «exige nota de encomenda» (só Master) e NE nas folhas
//
// Perfis (campo `perfil` em utilizadores/{uid}): master, backoffice, tecnico, comercial (futuro).
// Só utilizadores com documento de perfil e `ativo == true` acedem a dados.
// Preços de custo e margens (fases seguintes) ficarão em documentos/subcoleções próprias
// só legíveis pelo master — as regras não conseguem esconder campos dentro de um documento.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Sessão e perfil ----------
    function autenticado() { return request.auth != null; }
    function caminhoPerfil() { return /databases/$(database)/documents/utilizadores/$(request.auth.uid); }
    function ativo() {
      return autenticado() && exists(caminhoPerfil()) && get(caminhoPerfil()).data.ativo == true;
    }
    function perfil() { return get(caminhoPerfil()).data.perfil; }
    function eMaster() { return ativo() && perfil() == 'master'; }
    function eStaff() { return ativo() && perfil() in ['master', 'backoffice']; }
    function eTecnico() { return ativo() && perfil() == 'tecnico'; }
    function alterados() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function quemAlterouCerto() {
      return !alterados().hasAny(['atualizadoPor']) || request.resource.data.atualizadoPor == request.auth.uid;
    }

    // ---------- Utilizadores (perfis) ----------
    function utilizadorValido(d) {
      return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 120
        && d.email is string && d.email.matches('^[^@ ]+@[^@ ]+$')
        && d.perfil in ['master', 'backoffice', 'tecnico', 'comercial']
        && d.ativo is bool
        && (!('tecnico' in d) || d.tecnico is bool);
    }
    match /utilizadores/{uid} {
      // cada um lê o seu perfil; master e backoffice leem todos (lista de técnicos)
      allow get: if autenticado() && (request.auth.uid == uid || eStaff());
      allow list: if eStaff();
      allow create: if eMaster() && utilizadorValido(request.resource.data);
      // o master não pode mudar o próprio perfil/estado (evita ficar sem acesso)
      allow update: if eMaster() && utilizadorValido(request.resource.data)
        && (uid != request.auth.uid || !alterados().hasAny(['perfil', 'ativo', 'email']));
      allow delete: if false; // desativar em vez de apagar
    }

    // ---------- Clientes ----------
    function clienteValido(d) {
      return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 200
        && d.nif is string && d.nif.matches('^([0-9]{9}|[A-Z]{2}[A-Z0-9]{2,13})$')
        && (!('pesquisa' in d) || (d.pesquisa is list && d.pesquisa.size() <= 400));
    }
    match /clientes/{id} {
      allow read: if eStaff();
      // Clientes com origem 'phc' são escritos só pela PontePHC (conta de serviço, fora destas regras).
      allow create: if eStaff() && clienteValido(request.resource.data)
        && request.resource.data.get('origem', '') != 'phc'
        && (!('atualizadoPor' in request.resource.data) || request.resource.data.atualizadoPor == request.auth.uid);
      allow update: if eStaff() && clienteValido(request.resource.data) && quemAlterouCerto()
        && resource.data.get('origem', '') != 'phc' && request.resource.data.get('origem', '') != 'phc'
        && (eMaster() || !alterados().hasAny(['exigeNE', 'exigeNEPor', 'exigeNEEm']));
      // «Exige nota de encomenda»: campo da plataforma, também nos clientes do PHC; só o Master altera
      allow update: if eMaster()
        && alterados().hasOnly(['exigeNE', 'exigeNEPor', 'exigeNEEm'])
        && request.resource.data.exigeNE is bool && request.resource.data.exigeNEPor == request.auth.uid;
      allow delete: if eMaster();
    }

    // ---------- Contadores (numeração sequencial FO-AAAA-NNNN) ----------
    match /contadores/{id} {
      allow read: if eStaff();
      allow create: if eStaff() && request.resource.data.valor == 1;
      allow update: if eStaff() && request.resource.data.valor == resource.data.valor + 1;
      allow delete: if false;
    }

    // ---------- Folhas de obra ----------
    // Estados: Por agendar → Agendada → Em curso → Pendente (com motivo) → Concluída → Revista → Aguarda NE → Faturada
    function estados() { return ['Por agendar', 'Agendada', 'Em curso', 'Pendente', 'Concluída', 'Revista', 'Aguarda NE', 'Faturada', 'Anulada']; }
    function estadosMaster() { return ['Revista', 'Aguarda NE', 'Faturada', 'Anulada']; }
    function folhaValida(d) {
      return d.keys().hasAll(['numero', 'clienteId', 'clienteNome', 'tipo', 'tecnicoUid', 'tecnicoNome',
                              'dataPrevista', 'estado', 'historico', 'criadoEm', 'criadoPor'])
        && d.numero is string && d.numero.matches('^FO-[0-9]{4}-[0-9]{4,}$')
        && d.clienteId is string && d.clienteNome is string && d.clienteNome.size() > 0
        && d.tipo in ['Instalação', 'Manutenção', 'AT']
        && d.tecnicoUid is string
        && (d.dataPrevista == null || d.dataPrevista is timestamp)
        && d.estado in estados()
        // só "Por agendar" e "Anulada" podem estar sem técnico ou sem data
        && (d.estado in ['Por agendar', 'Anulada'] || (d.tecnicoUid.size() > 0 && d.dataPrevista is timestamp))
        // "Pendente" exige motivo
        && (d.estado != 'Pendente' || (d.get('pendencia', null) != null && d.pendencia.motivo in ['Peças', 'Orçamento', 'Cliente', 'Outro']))
        && d.historico is list && d.historico.size() <= 500
        && (!('observacoesTecnico' in d) || (d.observacoesTecnico is string && d.observacoesTecnico.size() <= 5000))
        && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 5000))
        && (!('pesquisa' in d) || (d.pesquisa is list && d.pesquisa.size() <= 400))
        && (!('clienteEmail' in d) || (d.clienteEmail is string && d.clienteEmail.size() <= 200))
        && (!('duracaoPrevista' in d) || (d.duracaoPrevista is number && d.duracaoPrevista >= 0 && d.duracaoPrevista <= 200))
        // folhas geradas por contrato de manutenção
        && (!('tarefasExtra' in d) || (d.tarefasExtra is list && d.tarefasExtra.size() <= 30))
        && (!('contratoId' in d) || (d.contratoId is string && d.contratoNumero is string))
        // nota de encomenda do cliente (Master): n.º e data
        && (!('ne' in d) || d.ne == null || (d.ne is map && d.ne.numero is string && d.ne.numero.size() > 0 && d.ne.numero.size() <= 60))
        // Fase 2: trabalho no local (sem preços)
        && (!('tempos' in d) || (d.tempos is list && d.tempos.size() <= 200))
        && (!('materiais' in d) || (d.materiais is list && d.materiais.size() <= 300))
        && (!('tarefas' in d) || d.tarefas is map)
        && (!('relatorio' in d) || (d.relatorio is string && d.relatorio.size() <= 10000))
        && (!('assinatura' in d) || d.assinatura == null
            || (d.assinatura is map && d.assinatura.imagem is string && d.assinatura.imagem.size() <= 200000));
    }
    function camposTrabalho() { return ['tempos', 'materiais', 'tarefas', 'relatorio', 'assinatura']; }
    function folhaNovaValida(d) {
      return d.estado == 'Por agendar'
        && d.historico.size() == 1
        && d.historico[0].estado == d.estado
        && d.historico[0].uid == request.auth.uid
        && d.criadoPor == request.auth.uid
        && d.criadoEm == request.time
        && exists(/databases/$(database)/documents/clientes/$(d.clienteId))
        && (d.tecnicoUid == '' || exists(/databases/$(database)/documents/utilizadores/$(d.tecnicoUid)));
    }
    // Cada mudança de estado acrescenta exatamente um registo ao histórico (utilizador + hora).
    function historicoValido() {
      let a = resource.data;
      let d = request.resource.data;
      let n = a.historico.size();
      return (d.estado == a.estado && d.historico == a.historico)
        || (d.estado != a.estado
            && d.historico.size() == n + 1
            && d.historico[0:n] == a.historico
            && d.historico[n].estado == d.estado
            && d.historico[n].uid == request.auth.uid
            && d.historico[n].em is timestamp
            && d.estadoAlteradoEm == request.time);
    }
    function transicaoTecnico(de, para) {
      return (de == 'Agendada' && para == 'Em curso')
        || (de == 'Em curso' && para in ['Pendente', 'Concluída'])
        || (de == 'Pendente' && para == 'Em curso');
    }
    function atualizacaoStaff() {
      // revisão, nota de encomenda e faturação: só o Master
      return eMaster()
        || (eStaff() && !(resource.data.estado in estadosMaster()) && !(request.resource.data.estado in estadosMaster()));
    }
    function atualizacaoTecnico() {
      return eTecnico()
        && resource.data.tecnicoUid == request.auth.uid
        && !(resource.data.estado in estadosMaster())
        && alterados().hasOnly(['estado', 'historico', 'estadoAlteradoEm', 'pendencia', 'observacoesTecnico', 'atualizadoEm', 'atualizadoPor',
                                'tempos', 'materiais', 'tarefas', 'relatorio', 'assinatura', 'relatorioCliente'])
        // tempos, material, tarefas, relatório e assinatura: só com o trabalho em curso ou pendente
        && (!alterados().hasAny(camposTrabalho()) || resource.data.estado in ['Em curso', 'Pendente'])
        && (request.resource.data.estado == resource.data.estado
            || transicaoTecnico(resource.data.estado, request.resource.data.estado))
        // o técnico só conclui com assinatura do cliente (ou registo de cliente ausente)
        && (request.resource.data.estado == resource.data.estado || request.resource.data.estado != 'Concluída'
            || request.resource.data.get('assinatura', null) is map);
    }
    match /folhas/{id} {
      // técnico: só as folhas atribuídas a si (as consultas têm de filtrar por tecnicoUid)
      allow get, list: if eStaff() || (eTecnico() && resource.data.tecnicoUid == request.auth.uid);
      allow create: if eStaff() && folhaValida(request.resource.data) && folhaNovaValida(request.resource.data);
      allow update: if folhaValida(request.resource.data)
        && !alterados().hasAny(['numero', 'criadoEm', 'criadoPor', 'criadoPorNome', 'clienteId'])
        && historicoValido()
        && quemAlterouCerto()
        && (atualizacaoStaff() || atualizacaoTecnico());
      allow delete: if eMaster() && resource.data.estado in ['Por agendar', 'Agendada'];

      // Preços, totais e valor/hora (vindos do PHC pela PontePHC): só o Master lê; ninguém escreve pela plataforma.
      match /privado/{doc} {
        allow read: if eMaster();
        allow write: if false;
      }
    }

    // ---------- Colaboradores (nome e função para os registos de tempo; sem preços) ----------
    function colaboradorValido(d) {
      return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 120
        && d.funcao in ['Técnico', 'Ajudante', 'Aprendiz']
        && d.ativo is bool
        && (!('externo' in d) || d.externo is bool)
        && (!('uid' in d) || d.uid is string);
    }
    match /colaboradores/{id} {
      allow read: if ativo() && perfil() in ['master', 'backoffice', 'tecnico'];
      allow create, update: if eMaster() && colaboradorValido(request.resource.data);
      allow delete: if false;
    }

    // ---------- Artigos do armazém da climatização (escritos pela PontePHC) ----------
    // A plataforma só mexe nas reservas: resFolhas (material em folhas não faturadas) e resGuias (material em guias abertas).
    match /artigos/{id} {
      allow read: if ativo();
      allow update: if ativo() && perfil() in ['master', 'backoffice', 'tecnico']
        && alterados().hasOnly(['resFolhas', 'resGuias', 'resAtualizadoEm'])
        && request.resource.data.get('resFolhas', 0) is number && request.resource.data.get('resFolhas', 0) >= 0
        && request.resource.data.get('resGuias', 0) is number && request.resource.data.get('resGuias', 0) >= 0;
      allow create, delete: if false;
      // preço de custo: só o Master
      match /privado/{doc} {
        allow read: if eMaster();
        allow write: if false;
      }
    }

    // ---------- Guias de Transporte AC (uma por viatura, destinatário = cliente) ----------
    // Criadas «Por comunicar»; o código AT e o número vêm do PHC/GuiasAT pela PontePHC (fora destas regras).
    function guiaValida(d) {
      return d.clienteId is string && d.clienteNome is string && d.clienteNome.size() > 0
        && d.tecnicoUid is string && d.tecnicoUid.size() > 0
        && d.viatura is string && d.viatura.size() >= 6 && d.viatura.size() <= 12
        && d.estado in ['Por comunicar', 'Comunicada', 'Fechada', 'Anulada']
        && d.dataSaida is timestamp
        && d.linhas is list && d.linhas.size() >= 1 && d.linhas.size() <= 100
        && d.historico is list && d.historico.size() <= 200;
    }
    match /guias/{id} {
      allow get, list: if eStaff() || (eTecnico() && resource.data.tecnicoUid == request.auth.uid);
      allow create: if (eStaff() || (eTecnico() && request.resource.data.tecnicoUid == request.auth.uid))
        && guiaValida(request.resource.data)
        && request.resource.data.estado == 'Por comunicar'
        && request.resource.data.codigoAT == '' && request.resource.data.numero == ''
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time;
      allow update: if guiaValida(request.resource.data)
        && !(resource.data.estado in ['Fechada', 'Anulada'])
        && !alterados().hasAny(['codigoAT', 'numero', 'criadoEm', 'criadoPor', 'clienteId', 'dataSaida', 'viatura'])
        && quemAlterouCerto()
        && (request.resource.data.estado == resource.data.estado
            || (resource.data.estado == 'Comunicada' && request.resource.data.estado == 'Fechada')
            || (resource.data.estado == 'Por comunicar' && request.resource.data.estado == 'Anulada'))
        && (eStaff() || (eTecnico() && resource.data.tecnicoUid == request.auth.uid
            && alterados().hasOnly(['linhas', 'estado', 'historico', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if false;
    }

    // ---------- Emails a enviar (relatório ao cliente): a PontePHC envia pelo Exchange e marca o estado ----------
    function emailValido(d) {
      return d.tipo in ['relatorio', 'agendamento'] && d.estado == 'Pendente'
        && d.para is string && d.para.matches('^[^@ ,;]+@[^@ ,;]+[.][^@ ,;]+$')
        && d.assunto is string && d.assunto.size() <= 200
        && d.html is string && d.html.size() <= 300000
        && d.texto is string && d.texto.size() <= 50000
        && d.assinaturaPng is string && d.assinaturaPng.size() <= 200000
        && d.folhaId is string && d.criadoPor == request.auth.uid;
    }
    match /emails/{id} {
      allow read: if eStaff();
      // técnico: só para folhas suas
      allow create: if emailValido(request.resource.data)
        && (eStaff() || (eTecnico() && request.resource.data.tipo == 'relatorio'
            && get(/databases/$(database)/documents/folhas/$(request.resource.data.folhaId)).data.tecnicoUid == request.auth.uid));
      allow update, delete: if false;
    }

    // ---------- N.º de série dos equipamentos: onde está cada um (numa guia aberta ou aplicado numa folha) ----------
    // Evita usar o mesmo n.º de série duas vezes. Escrito na mesma transação que a guia ou a folha.
    match /series/{id} {
      allow read: if ativo() && perfil() in ['master', 'backoffice', 'tecnico'];
      allow create, update: if ativo() && perfil() in ['master', 'backoffice', 'tecnico']
        && request.resource.data.serie is string && request.resource.data.serie.size() >= 3 && request.resource.data.serie.size() <= 60
        && request.resource.data.estado in ['guia', 'folha']
        && request.resource.data.uid == request.auth.uid;
      allow delete: if ativo() && perfil() in ['master', 'backoffice', 'tecnico'];
    }

    // ---------- Contratos de manutenção ----------
    // Master e backoffice gerem; o técnico não vê (recebe só as folhas geradas). Nunca se apagam: terminam.
    // O valor do contrato fica em contratos/{id}/privado/valores (só o Master).
    function contratoValido(d) {
      return d.numero is string && d.numero.matches('^CM-[0-9]{4}-[0-9]{3,}$')
        && d.clienteId is string && d.clienteNome is string && d.clienteNome.size() > 0
        && d.estado in ['Ativo', 'Suspenso', 'Terminado']
        && d.periodicidade in ['Mensal', 'Bimestral', 'Trimestral', 'Semestral', 'Anual']
        && d.proximaData is timestamp && d.geracaoEm is timestamp
        && d.antecedenciaDias is int && d.antecedenciaDias >= 0 && d.antecedenciaDias <= 120
        && d.tecnicoUid is string
        && (d.get('dataFim', null) == null || d.dataFim is timestamp)
        && d.equipamentos is list && d.equipamentos.size() <= 100
        && d.tarefas is list && d.tarefas.size() <= 30
        && d.folhas is list && d.folhas.size() <= 24
        && (!('ambito' in d) || (d.ambito is string && d.ambito.size() <= 5000))
        && (!('pesquisa' in d) || (d.pesquisa is list && d.pesquisa.size() <= 400));
    }
    match /contratos/{id} {
      allow read: if eStaff();
      allow create: if eStaff() && contratoValido(request.resource.data)
        && request.resource.data.estado == 'Ativo'
        && request.resource.data.criadoPor == request.auth.uid
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId));
      allow update: if eStaff() && contratoValido(request.resource.data)
        && !alterados().hasAny(['numero', 'clienteId', 'criadoEm', 'criadoPor'])
        && (resource.data.estado != 'Terminado' || request.resource.data.estado == 'Terminado');
      allow delete: if false;

      match /privado/{doc} {
        allow read, write: if eMaster();
      }
    }

    // ---------- Pedido de sincronização imediata com o PHC (a PontePHC responde) ----------
    match /controlo/{id} {
      allow read: if eStaff();
      allow write: if eStaff() && id == 'sincronizar'
        && request.resource.data.keys().hasOnly(['estado', 'pedidoEm', 'pedidoPor', 'pedidoPorNome'])
        && request.resource.data.estado == 'Pedido'
        && request.resource.data.pedidoPor == request.auth.uid
        && request.resource.data.pedidoEm == request.time;
    }

    // ---------- Listas simples (ex.: viaturas): todos leem, só o Master altera ----------
    match /listas/{id} {
      allow read: if ativo();
      allow write: if eMaster();
    }

    // ---------- Configuração (tabela de preço/hora da mão de obra): só o Master ----------
    match /config/{id} {
      allow read, write: if eMaster();
    }

    // Tudo o resto: recusado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
